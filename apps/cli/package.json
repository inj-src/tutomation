    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
