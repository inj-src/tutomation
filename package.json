{
  "name": "tutomation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=server --filter=web",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "login": "pnpm --filter cli login",
    "evaluate": "pnpm --filter cli evaluate"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "eslint": "^10.9.1",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "latest"
  }
}
