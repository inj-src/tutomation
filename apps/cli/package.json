{
  "name": "cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "tsx src/index.ts login",
    "evaluate": "tsx src/index.ts evaluate",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
