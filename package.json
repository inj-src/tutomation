{
  "name": "tutomation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=server --filter=web",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "login": "pnpm --filter cli login",
    "evaluate": "pnpm --filter cli evaluate"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "2.10.12"
  }
}
